// validateItem checks one submitted [[.Type]]. exceptID is the row being
// updated, or 0 when creating, so the uniqueness rule can ignore the row's own
// value. Cheap rules come first: a failure short-circuits the field, so the
// database is never queried for input that was blank or too long anyway.
func (ct *Controller) validateItem(ctx context.Context, item [[.Type]], exceptID int64) *validate.Validator {
	v := validate.New()
	v.Field("name", item.Name, validate.Required, validate.MaxLen(200), ct.nameAvailable(ctx, exceptID))
	// TODO: add a Field call per bound field.
	return v
}

// nameAvailable rejects a name another row already uses. A failed query degrades
// to a message on the form rather than a 500 — the user gets something
// actionable, and the cause is in the log.
func (ct *Controller) nameAvailable(ctx context.Context, exceptID int64) validate.Rule {
	return func(name string) error {
		taken, err := ct.nameTaken(ctx, name, exceptID)
		if err != nil {
			slog.Error("check [[.Table]] name", "err", err)
			return errors.New("could not be verified, please try again")
		}
		if taken {
			return errors.New("is already taken")
		}
		return nil
	}
}

