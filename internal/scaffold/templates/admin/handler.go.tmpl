// Mount registers the admin [[.Type]] routes under the admin prefix, guarded by
// the admin auth middleware, and adds a menu entry so the resource appears in
// the admin shell.
func Mount(eng *inertia.Engine, svc *app.Services, adm *admin.Admin) {
	ct := &Controller{Services: svc, base: adm.Prefix() + "/[[.Route]]"}
	auth := adm.AuthMiddleware()

	eng.GET(ct.base, auth, ct.Index)
	eng.GET(ct.base+"/new", auth, ct.New)
	eng.POST(ct.base, auth, ct.Create)
	eng.GET(ct.base+"/:id/edit", auth, ct.Edit)
	eng.POST(ct.base+"/:id", auth, ct.Update)
	eng.POST(ct.base+"/:id/delete", auth, ct.Delete)

	adm.AddMenuItem(admin.MenuItem{Title: "[[.Type]]", Path: ct.base})
}

