{
  "include": [
    "vite.config.*",
    "ssr-build.ts",
    "ssr-esm-render.ts",
    "ssr-modules.ts",
    "ssr/**/*",
    "scripts/**/*"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  }
}
