{
  "include": ["vite.config.*", "ssr-esm-render.ts", "ssr/**/*", "scripts/**/*"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    // vite/client supplies `import.meta.glob`, used by ssr-esm-render.ts.
    "types": ["node", "vite/client"]
  }
}
