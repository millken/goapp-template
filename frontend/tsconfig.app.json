{
  "include": ["src/**/*", "pages/**/*"],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    // vite/client declares the ?raw and ?url module suffixes. deviations.test.ts
    // reads component source through ?raw rather than node's fs, so this config
    // keeps its DOM-only lib set.
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@pages/*": ["./pages/*"]
    }
  }
}
