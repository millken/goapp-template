{
  "name": "myapp-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit",
    "generate": "tsx scripts/gen-ssr-modules.ts",
    "build:pages": "tsx scripts/gen-ssr-modules.ts && vite build && tsx ssr-build.ts",
    "dev:pages": "tsx scripts/gen-ssr-modules.ts && vite build --watch",
    "build:ssr": "tsx ssr-build.ts"
  },
  "dependencies": {
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.7.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "esbuild": "^0.28.0",
    "millken-esbuild-plugin-vue": "^0.9.4",
    "npm-run-all2": "^8.0.4",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.12",
    "vue-tsc": "^3.2.8"
  }
}
