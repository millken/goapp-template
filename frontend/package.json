{
  "name": "myapp-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit",
    "generate": "tsx scripts/gen-ssr-modules.ts",
    "build:pages": "tsx scripts/gen-ssr-modules.ts && vite build && tsx ssr-build.ts",
    "dev:pages": "tsx scripts/gen-ssr-modules.ts && vite build --watch",
    "build:ssr": "tsx ssr-build.ts"
  },
  "dependencies": {
    "millken-inertia-vue": "npm:millken-inertia-vue",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "esbuild": "^0.25.0",
    "millken-esbuild-plugin-vue": "^0.9.0",
    "npm-run-all2": "^8.0.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "postcss": "^8.0.0",
    "typescript": "~5.8.0",
    "vite": "^7.0.0",
    "vue-tsc": "^2.0.0",
    "tsx": "^4.0.0"
  }
}
